<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="Album art"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:id="@+id/widget_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="MusicAmp"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="#FF00FF19"
        android:progressBackgroundTint="#40FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_shuffle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="Shuffle"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_shuffle" />

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_prev" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Play"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="Next"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_next" />

        <ImageButton
            android:id="@+id/widget_repeat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="Repeat"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_repeat" />
    </LinearLayout>
</LinearLayout>
